# Copy to .env at repo root:  copy .env.example .env
# Never commit .env. Values below are safe placeholders only.

# PostgreSQL (docker-compose service name: postgres)
POSTGRES_DB=payagent
POSTGRES_USER=payagent
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

# Spring Boot API
PAYAGENT_API_PORT=8080
PAYAGENT_DB_URL=jdbc:postgresql://postgres:5432/payagent
PAYAGENT_DB_USER=payagent
PAYAGENT_DB_PASSWORD=change-me-local
PAYAGENT_JWT_SECRET=change-me-use-long-random-string-min-32-chars

# PayPal Sandbox ONLY (Member B)
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Spring AI / OpenAI-compatible LLM (Member C) — optional for local bootstrap
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=
SPRING_AI_OPENAI_MODEL=gpt-4o-mini

# Evidence storage (Member E)
PAYAGENT_EVIDENCE_STORAGE_PATH=./data/evidence
PAYAGENT_EVIDENCE_SIGNING_SECRET=change-me-evidence-hmac-secret

# Next.js web (Member D)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_USE_MOCKS=true
WEB_PORT=3000
